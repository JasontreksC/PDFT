META_API_KEY=
OPENAI_API_KEY=
PDFT_CONTEXT_CAP=
PDFT_PORT=9000
# Docling container (기본 번역): CPU threads (empty = all cores), optional shared token for pdft <-> docling
DOCLING_THREADS=
PDFT_DOCLING_TOKEN=

# ---- 로그인과 회원 (Google 계정) ----
# 사람들이 접속하는 주소. Google Cloud Console의 "승인된 리디렉션 URI"에 <이 주소>/auth/callback 을 등록하세요.
PDFT_PUBLIC_URL=
# 회원 DB(PostgreSQL 컨테이너) 암호: 아무 긴 문자열. 예) openssl rand -hex 24
POSTGRES_PASSWORD=
# 관리자의 Google 계정 이메일, 쉼표로 구분. 이 계정으로 로그인했을 때만 관리자 대시보드가 보입니다
PDFT_ADMIN_EMAILS=
# 로그인을 허용할 계정을 제한하려면 (둘 다 비우면 Google 계정이 있는 누구나)
PDFT_ALLOWED_EMAILS=
PDFT_ALLOWED_DOMAINS=
# OAuth 클라이언트 JSON 파일 위치 (기본 ./pdft_client_secert.json)
PDFT_GOOGLE_CLIENT_JSON=
# google(기본) | off (로그인 없음: 혼자 쓰는 설치에서만)
PDFT_AUTH=google
